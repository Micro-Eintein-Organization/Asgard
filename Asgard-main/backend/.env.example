# Reference for optional host-run development. Compose uses the root .env only.
# The supported onboarding workflow runs Python 3.13 in Docker.
ASGARD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ASGARD_SUPABASE_URL=http://127.0.0.1:55321
ASGARD_SUPABASE_ANON_KEY=
ASGARD_GROQ_ENABLED=false
ASGARD_GROQ_API_KEY=
ASGARD_GROQ_MODEL=openai/gpt-oss-120b
ASGARD_GROQ_MAX_COMPLETION_TOKENS=4096
