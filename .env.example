# Required by Compose. node scripts/dev.mjs env fills the local values safely.
ASGARD_PROJECT_ID=asgard-foundation
ASGARD_DEPLOYMENT_ENVIRONMENT=local
FRONTEND_PORT=5173
BACKEND_PORT=8000
ASGARD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ASGARD_SUPABASE_URL=http://supabase_kong_asgard-foundation:8000
ASGARD_SUPABASE_ANON_KEY=
# Stage 3 remains disabled until the Auth configuration and SQL review gate is approved.
ASGARD_AUTH_ENABLED=false
# Enable after the reviewed migration, maintenance worker and operator checks.
ASGARD_ACCOUNT_DELETION_ENABLED=false
# Enable only after the recovery migration and disposable-account security acceptance.
ASGARD_RECOVERY_CODES_ENABLED=false
# Backend-only Supabase Auth admin credential; never put this in a VITE_ variable.
ASGARD_RECOVERY_AUTH_ADMIN_KEY=
ASGARD_AUTH_ISSUER=http://127.0.0.1:55321/auth/v1
ASGARD_DATABASE_URL=
# Backend-only Groq configuration. Supply your own key in ignored .env.
ASGARD_AI_GUIDANCE_ENABLED=false
ASGARD_EXA_API_KEY=
ASGARD_AI_SEARCH_DOMAINS=
ASGARD_GROQ_ENABLED=false
ASGARD_GROQ_API_KEY=
ASGARD_GROQ_MODEL=openai/gpt-oss-120b
ASGARD_GROQ_MAX_COMPLETION_TOKENS=4096
ASGARD_DOCUMENTS_ENABLED=false
ASGARD_DOCUMENTS_PROCESSING_ENABLED=false
ASGARD_RESUME_SKILL_REVIEW_ENABLED=false
# Set both only after publishing the reviewed benchmark source/version.
ASGARD_SKILL_MATCHING_BENCHMARK_SOURCE=
ASGARD_SKILL_MATCHING_BENCHMARK_VERSION=
ASGARD_PROFILE_PHOTOS_ENABLED=false
ASGARD_DOCUMENTS_REAL_DATA_APPROVED=false
# Backend-only private Storage gateway; never VITE_ or browser configuration.
ASGARD_STORAGE_SERVICE_KEY=
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=
# Enable only after this environment passes the MFA capability/security review.
VITE_MFA_ENROLLMENT_APPROVED=false
